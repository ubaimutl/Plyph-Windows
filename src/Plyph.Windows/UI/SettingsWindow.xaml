<Window
    x:Class="Plyph.Windows.UI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Plyph Settings">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="38" Padding="14,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ContentPresenter x:Name="BrandLogoHost" VerticalAlignment="Center" />
                <TextBlock Text="Plyph Settings"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" />
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="4"
                        Padding="6,2"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="ModeBadgeText"
                               Text="Installed"
                               FontSize="11"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <NavigationView Grid.Row="1"
                        x:Name="NavView"
                        AutomationProperties.AutomationId="SettingsNavigationView"
                        PaneDisplayMode="Auto"
                        CompactModeThresholdWidth="680"
                        ExpandedModeThresholdWidth="880"
                        OpenPaneLength="220"
                        HorizontalContentAlignment="Stretch"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="NavView_SelectionChanged"
                        ItemInvoked="NavView_ItemInvoked">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General"
                                    Tag="general"
                                    AutomationProperties.AutomationId="NavGeneralItem"
                                    IsSelected="True">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Toolbar" Tag="toolbar">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE7F8;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="AI Providers"
                                    Tag="providers"
                                    AutomationProperties.AutomationId="NavProvidersItem">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Actions &amp; Prompts"
                                    Tag="actions"
                                    AutomationProperties.AutomationId="NavActionsItem">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE70F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Personalization" Tag="personalization">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Shortcuts &amp; Capture"
                                    Tag="shortcuts"
                                    AutomationProperties.AutomationId="NavShortcutsItem">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE765;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Open data folder"
                                    Tag="open-folder"
                                    SelectsOnInvoked="False"
                                    AutomationProperties.AutomationId="NavOpenFolderItem">
                    <NavigationViewItem.Icon>
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE838;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" HorizontalContentAlignment="Stretch" />
        </NavigationView>
    </Grid>
</Window>
