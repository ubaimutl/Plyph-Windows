<Window
    x:Class="Plyph.Windows.UI.ActionPaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Plyph Actions">

    <Grid x:Name="RootGrid">
        <Border x:Name="SurfaceBorder"
                Background="{ThemeResource PopupSurfaceOverlayBrush}"
                BorderBrush="{ThemeResource PopupSurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="6">
            <Grid RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox x:Name="SearchBox"
                         Grid.Row="0"
                         PlaceholderText="Search actions…"
                         Height="30"
                         MinHeight="30"
                         FontSize="12.5"
                         Padding="8,4"
                         TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown" />

                <ScrollViewer x:Name="ListScrollViewer"
                              Grid.Row="1"
                              MaxHeight="300"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ItemsStack" Spacing="2" />
                </ScrollViewer>

                <TextBlock x:Name="ProviderFooterText"
                           Grid.Row="2"
                           Margin="8,4,8,2"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
