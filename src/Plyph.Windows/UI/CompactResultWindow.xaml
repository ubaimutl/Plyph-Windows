<Window
    x:Class="Plyph.Windows.UI.CompactResultWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Plyph">

    <Grid x:Name="RootGrid">
        <Border x:Name="SurfaceBorder"
                Background="Transparent"
                BorderBrush="{ThemeResource PopupSurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,12">
            <Grid KeyDown="RootGrid_KeyDown">
                <Grid.Resources>
                    <Style x:Key="PopupIconToggleStyle" TargetType="ToggleButton">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="UseSystemFocusVisuals" Value="True" />
                    </Style>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid x:Name="HeaderDragArea"
                                Grid.Column="0"
                                ColumnSpacing="6"
                                Background="Transparent"
                                VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="ActionIconHost" Width="17" Height="17"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                          VerticalAlignment="Center" />
                        <TextBlock x:Name="ActionTitleText" Grid.Column="1"
                                   Text="Result"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button x:Name="PrevButton" Grid.Column="2"
                                AutomationProperties.Name="Previous revision"
                                ToolTipService.ToolTip="Previous revision"
                                Style="{StaticResource SubtleButtonStyle}"
                                Visibility="Collapsed"
                                Width="22"
                                Height="22"
                                Padding="0"
                                Click="PrevButton_Click">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE76B;" FontSize="10" />
                        </Button>
                        <TextBlock x:Name="RevisionCountLabel" Grid.Column="3"
                                   FontSize="11.5"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="Collapsed"
                                   VerticalAlignment="Center" />
                        <Button x:Name="NextButton" Grid.Column="4"
                                AutomationProperties.Name="Next revision"
                                ToolTipService.ToolTip="Next revision"
                                Style="{StaticResource SubtleButtonStyle}"
                                Visibility="Collapsed"
                                Width="22"
                                Height="22"
                                Padding="0"
                                Click="NextButton_Click">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE76C;" FontSize="10" />
                        </Button>
                    </Grid>

                    <TextBlock x:Name="ProviderBadgeText"
                               Grid.Column="1"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               MaxWidth="124"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />

                    <ToggleButton x:Name="PinButton" Style="{StaticResource PopupIconToggleStyle}"
                                  Grid.Column="2"
                                  AutomationProperties.Name="Pin popup"
                                  ToolTipService.ToolTip="Keep this popup open when clicking outside"
                                  Width="26"
                                  Height="26"
                                  Padding="0"
                                  BorderThickness="0"
                                  Click="PinButton_Click">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE718;" FontSize="11" />
                    </ToggleButton>

                    <Button x:Name="CloseButton"
                            Grid.Column="3"
                            AutomationProperties.AutomationId="CompactResultCancelButton"
                            AutomationProperties.Name="Close"
                            ToolTipService.ToolTip="Dismiss (Esc)"
                            Style="{StaticResource SubtleButtonStyle}"
                            Width="26"
                            Height="26"
                            Padding="0"
                            Click="CloseButton_Click">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE711;" FontSize="11" />
                    </Button>
                </Grid>

                <StackPanel x:Name="AskInputPanel" Grid.Row="1" Margin="0,8,0,0" Spacing="6" Visibility="Collapsed">
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="AskPromptBox"
                                 AutomationProperties.AutomationId="AskPromptBox"
                                 AutomationProperties.Name="Ask prompt input"
                                 PlaceholderText="Ask a question or request a change…"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MaxHeight="90"
                                 FontSize="13"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 PreviewKeyDown="AskPromptBox_PreviewKeyDown"
                                 TextChanged="AskPromptBox_TextChanged" />

                        <Button Grid.Column="1"
                                x:Name="AskSendButton"
                                AutomationProperties.AutomationId="AskSubmitButton"
                                ToolTipService.ToolTip="Ask AI (Enter)"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="32"
                                Padding="10,0"
                                VerticalAlignment="Bottom"
                                Click="AskSendButton_Click">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE724;" FontSize="12" />
                        </Button>
                    </Grid>
                    <CheckBox x:Name="IncludeSelectionBox" Content="Include selected text" MinHeight="24" />
                    <TextBlock Text="Enter to send · Shift+Enter for new line · Esc to cancel"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <Grid x:Name="WorkingPanel" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed" ColumnSpacing="10" Padding="2,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressRing Grid.Column="0"
                                  x:Name="WorkingSpinner"
                                  Width="18"
                                  Height="18"
                                  IsActive="False"
                                  VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="WorkingStatusText"
                               Text="Working…"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2"
                            Content="Cancel"
                            Height="28"
                            Padding="10,0"
                            FontSize="12"
                            Click="CloseButton_Click" />
                </Grid>

                <Grid x:Name="ResultBodyPanel" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBox x:Name="ResultEditorBox"
                             AutomationProperties.AutomationId="CompactResultEditorBox"
                             AutomationProperties.Name="Generated result text"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             FontSize="13.5"
                             BorderThickness="0"
                             CornerRadius="6"
                             Background="Transparent"
                             Padding="0,2"
                             MinHeight="36"
                             MaxHeight="180"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             TextChanged="ResultEditorBox_TextChanged">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                        </TextBox.Resources>
                    </TextBox>

                    <Border x:Name="DiffContainer"
                            Visibility="Collapsed"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Padding="0,2"
                            MaxHeight="180">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <RichTextBlock x:Name="DiffRichTextBlock"
                                           IsTextSelectionEnabled="True"
                                           FontSize="13.5"
                                           TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>

                <Border x:Name="DiscussionPane"
                        Grid.Row="2" Margin="0,8,0,0"
                        Visibility="Collapsed"
                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                        CornerRadius="6"
                        Padding="8"
                        MaxHeight="160">
                    <ScrollViewer x:Name="DiscussionScrollViewer" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DiscussionStack" Spacing="6" />
                    </ScrollViewer>
                </Border>

                <InfoBar Grid.Row="3"
                         x:Name="ReplacementWarningBar"
                         Severity="Warning"
                         IsOpen="False"
                         IsClosable="False" />

                <Grid x:Name="FollowUpRow" Grid.Row="4" Margin="0,8,0,0" Visibility="Collapsed" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             x:Name="FollowUpInputBox"
                             PlaceholderText="Refine (e.g. shorter, more formal)…"
                             FontSize="12.5"
                             Height="30"
                             MinHeight="30"
                             Padding="8,4"
                             KeyDown="FollowUpInputBox_KeyDown" />

                    <Button Grid.Column="1"
                            x:Name="FollowUpSendButton"
                            ToolTipService.ToolTip="Send"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="30"
                            Padding="9,0"
                            Click="FollowUpSendButton_Click">
                        <Grid>
                            <FontIcon x:Name="FollowUpSendIcon"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      Glyph="&#xE724;"
                                      FontSize="12" />
                            <ProgressRing x:Name="FollowUpSpinner"
                                          Width="14"
                                          Height="14"
                                          Visibility="Collapsed"
                                          IsActive="False" />
                        </Grid>
                    </Button>
                </Grid>

                <InfoBar Grid.Row="5"
                         x:Name="StatusInfoBar"
                         Severity="Error"
                         IsOpen="False"
                         IsClosable="True" />

                <StackPanel x:Name="ErrorFooterRow"
                            Grid.Row="6" Margin="0,8,0,0"
                            Visibility="Collapsed"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="6">
                    <Button x:Name="ErrorOpenSettingsButton"
                            Content="Open Settings"
                            Visibility="Collapsed"
                            Height="28"
                            Padding="10,0"
                            FontSize="12"
                            Click="ErrorOpenSettingsButton_Click" />
                    <Button x:Name="ErrorCopyButton"
                            Content="Copy error"
                            Height="28"
                            Padding="10,0"
                            FontSize="12"
                            Click="ErrorCopyButton_Click" />
                    <Button Content="Close"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="28"
                            Padding="12,0"
                            FontSize="12"
                            Click="CloseButton_Click" />
                </StackPanel>

                <Grid x:Name="ResultFooterRow" Grid.Row="7" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Rectangle Grid.ColumnSpan="2" Height="1" Margin="0,0,0,8"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button x:Name="CopyIconButton"
                                AutomationProperties.AutomationId="CompactResultCopyButton"
                                AutomationProperties.Name="Copy"
                                ToolTipService.ToolTip="Copy to clipboard"
                                Style="{StaticResource SubtleButtonStyle}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Click="CopyButton_Click">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE8C8;" FontSize="15" />
                        </Button>

                        <ToggleButton x:Name="RefineToggle" Style="{StaticResource PopupIconToggleStyle}"
                                      AutomationProperties.Name="Refine"
                                      ToolTipService.ToolTip="Refine result"
                                      Visibility="Collapsed"
                                      Width="32"
                                      Height="32"
                                      Padding="0"
                                      BorderThickness="0"
                                      Click="RefineToggle_Click">
                            <PathIcon x:Name="RefineIcon"
                                      Data="M4,17.5 L13.2,8.3 L15.7,10.8 L6.5,20 Z M14.3,7.2 L16.1,5.4 L18.6,7.9 L16.8,9.7 Z M6,3 L6.7,5.3 L9,6 L6.7,6.7 L6,9 L5.3,6.7 L3,6 L5.3,5.3 Z M19,13 L19.8,15.2 L22,16 L19.8,16.8 L19,19 L18.2,16.8 L16,16 L18.2,15.2 Z" />
                        </ToggleButton>

                        <ToggleButton x:Name="ChangesToggle" Style="{StaticResource PopupIconToggleStyle}"
                                      AutomationProperties.Name="Show changes"
                                      ToolTipService.ToolTip="Show inline changes"
                                      Visibility="Collapsed"
                                      Width="32"
                                      Height="32"
                                      Padding="0"
                                      BorderThickness="0"
                                      Checked="ChangesToggle_CheckedChanged"
                                      Unchecked="ChangesToggle_CheckedChanged">
                            <PathIcon x:Name="ChangesIcon"
                                      Data="M2,4 H22 V6 H2 Z M2,18 H22 V20 H2 Z M11,6 H13 V18 H11 Z M4,11 H9 V13 H4 Z M16.5,8.5 H18.5 V11 H21 V13 H18.5 V15.5 H16.5 V13 H14 V11 H16.5 Z" />
                        </ToggleButton>

                        <ToggleButton x:Name="DiscussToggle" Style="{StaticResource PopupIconToggleStyle}"
                                      AutomationProperties.Name="Discuss"
                                      ToolTipService.ToolTip="Discuss this result"
                                      Visibility="Collapsed"
                                      Width="32"
                                      Height="32"
                                      Padding="0"
                                      BorderThickness="0"
                                      Click="DiscussToggle_Click">
                            <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE90A;" FontSize="15" />
                        </ToggleButton>

                        <Button x:Name="ExpandButton"
                                AutomationProperties.AutomationId="CompactResultExpandButton"
                                AutomationProperties.Name="Enlarge popup"
                                ToolTipService.ToolTip="Enlarge popup"
                                Style="{StaticResource SubtleButtonStyle}"
                                Width="32"
                                Height="32"
                                Padding="0"
                                Click="ExpandButton_Click">
                            <FontIcon x:Name="ExpandIcon" FontFamily="{ThemeResource SymbolThemeFontFamily}" Glyph="&#xE740;" FontSize="15" />
                        </Button>
                    </StackPanel>

                    <Button Grid.Row="1" Grid.Column="1"
                            x:Name="PrimaryActionButton"
                            AutomationProperties.AutomationId="CompactResultReplaceButton"
                            Style="{StaticResource AccentButtonStyle}"
                            Height="32"
                            MinWidth="80"
                            Padding="12,0"
                            FontSize="12.5"
                            Content="Replace"
                            Click="PrimaryActionButton_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
