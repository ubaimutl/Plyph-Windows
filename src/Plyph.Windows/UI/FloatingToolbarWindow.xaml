<Window
    x:Class="Plyph.Windows.UI.FloatingToolbarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Plyph Toolbar">

    <Grid x:Name="RootGrid">
        <Grid.Resources>
            <Style x:Key="ToolbarMinimalButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootBorder"
                                  Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <Border x:Name="HoverOverlay"
                                        Background="Transparent"
                                        CornerRadius="{TemplateBinding CornerRadius}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter x:Name="ContentPresenter"
                                                      Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                </Border>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="HoverOverlay" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Border x:Name="SurfaceBorder"
                Background="{ThemeResource PopupSurfaceOverlayBrush}"
                BorderBrush="{ThemeResource PopupSurfaceBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="3"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                PointerEntered="SurfaceBorder_PointerEntered"
                PointerExited="SurfaceBorder_PointerExited">
            <StackPanel x:Name="MainStack" Spacing="0">
                <StackPanel x:Name="ToolbarPanel"
                            Orientation="Horizontal"
                            Spacing="2"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center" />

                <Rectangle x:Name="ExtendedDivider"
                           Height="1"
                           Margin="4,3"
                           Visibility="Collapsed"
                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <StackPanel x:Name="ExtendedContainer"
                            Visibility="Collapsed"
                            Spacing="2">
                    <ScrollViewer x:Name="ExtendedScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ExtendedActionsStack" Spacing="1" />
                    </ScrollViewer>
                    <Rectangle Height="1"
                               Margin="4,3,4,2"
                               Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock x:Name="ExtendedProviderText"
                               FontSize="11"
                               Margin="8,2,8,4"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
